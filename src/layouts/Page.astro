---
import SearchButton from '../components/SearchButton.astro';
import Lightbox from '../components/Lightbox.astro';
import metadata from '../data/metadata.json';

interface Props { bodyClass?: string; }
const { bodyClass = 'post-template' } = Astro.props;
const route = Astro.url.pathname;
const meta = metadata[route as keyof typeof metadata] ?? metadata['/'];
const canonical = new URL(route, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="robots" content="noindex" />
    <meta property="og:site_name" content="Jaime Neary" />
    <meta property="og:type" content={meta.type} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={meta.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={meta.twitterImage} />
    {meta.structuredData && <script type="application/ld+json" set:html={JSON.stringify(meta.structuredData).replace(/</g, '\\u003c')} />}
    <link rel="alternate" type="application/rss+xml" title="Jaime Neary" href="/rss/" />
    <link rel="stylesheet" href="/assets/built/screen.css" />
    <link rel="stylesheet" href="/public/cards.min.css" />
    <link rel="stylesheet" href="/static-search.css" />
    <style is:global>:root { --ghost-accent-color: #4ecdc4; }</style>
    <script is:inline defer src="/public/cards.min.js"></script>
  </head>
  <body class={`${bodyClass} is-head-left-logo`}>
    <div class="site">
      <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner">
          <div class="gh-head-brand">
            <div class="gh-head-brand-wrapper"><a class="gh-head-logo" href="/">Jaime Neary</a></div>
            <SearchButton />
            <button class="gh-burger" aria-label="Toggle menu"></button>
          </div>
          <nav class="gh-head-menu">
            <ul class="nav">
              <li class:list={['nav-home', { 'nav-current': route === '/' }]}><a href="/">Home</a></li>
              <li class:list={['nav-about', { 'nav-current': route === '/about/' }]}><a href="/about/">About</a></li>
            </ul>
          </nav>
          <div class="gh-head-actions"><SearchButton /></div>
        </div>
      </header>
      <div class="site-content"><slot /></div>
      <footer class="gh-foot no-menu gh-outer">
        <div class="gh-foot-inner gh-inner">
          <div class="gh-copyright">Jaime Neary © {new Date().getFullYear()}</div>
        </div>
      </footer>
    </div>
    <Lightbox />
    <script is:inline src="/assets/vendor/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script is:inline src="/assets/built/main.min.js"></script>
    <script is:inline defer src="/static-search.js"></script>
  </body>
</html>
